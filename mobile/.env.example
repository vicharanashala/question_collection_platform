# ─── Environment ──────────────────────────────────────────────────────────────
# Set to 'production' when building for a real app store release.
# Anything other than 'production' is treated as 'development'.
EXPO_PUBLIC_ENV=development

# ─── API Base URL ─────────────────────────────────────────────────────────────
# Include the /api/v1 suffix.
#
# Dev mappings:
#   iOS Simulator:      http://localhost:3000/api/v1
#   Android Emulator:   http://10.0.2.2:3000/api/v1  (host machine via 10.0.2.2)
#   Physical device:    http://<your-machine-ip>:3000/api/v1  OR  ngrok tunnel URL
#   Staging (Cloud Run): https://your-staging-service.run.app/api/v1
#   Production:         https://your-production-service.run.app/api/v1
EXPO_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api/v1

# ─── Support Contact ───────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com

# ─── FAQ Video ─────────────────────────────────────────────────────────────────
# Direct YouTube embed URL (shown on FAQ screen)
EXPO_PUBLIC_FAQ_VIDEO_URL=https://www.youtube.com/embed/dQw4w9WgXcQ

# Embed URL served from the API origin — YouTube iframe requires a valid HTTPS
# referer from a non-file origin. Format:
#   {API_BASE_URL}/embed/faq-video?videoId={YOUTUBE_VIDEO_ID}
# Use localhost URL in dev; point to staging/production URL in those environments.
EXPO_PUBLIC_FAQ_VIDEO_EMBED_URL=https://api.yourdomain.com/api/v1/embed/faq-video?videoId=dQw4w9WgXcQ