# Application
NODE_ENV=development
PORT=3000
OTP_RATE_LIMIT=false  # Disable in dev; set to true in staging/production
THROTTLE_ENABLED=false # Set to false to disable NestJS global throttle in dev

# ─── Database ────────────────────────────────────────────────────────────────
# Set DB=mongo or DB=postgres in backend/src/config/configuration.ts
# MongoDB (used when DB=mongo)
MONGODB_URL=mongodb+srv://<username>:<password>@<host>/<dbname>?appName=staging

# PostgreSQL (used when DB=postgres)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=annam
# DB_PASSWORD=change-me-in-production
# DB_NAME=question_platform

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here-min-32-chars-long
JWT_EXPIRES_IN=7d

# ─── Redis ───────────────────────────────────────────────────────────────────
# Set to 'false' to disable Redis entirely (cache/rate-limits/offline mode)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=1
REDIS_TLS=false  # Set to 'true' for cloud-hosted Redis (Upstash, Memorystore, etc.)

# ─── SMS Gateway ─────────────────────────────────────────────────────────────
# Provider: 'mock' | 'fast2sms'
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=AGRIAPP

# Fast2SMS
FAST2SMS_SENDER_ID=Annam.Ai
FAST2SMS_API_KEY=your-fast2sms-api-key
FAST2SMS_ROUTE=q

# ─── Sarvam AI (Speech-to-Text & Translate) ──────────────────────────────────
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_TRANSLATE_URL=https://api.sarvam.ai/translate

# ─── Reviewer Backend (LGD data — states, districts, subdistricts, villages, kvks) ──
# Used in place of data.gov.in LGD APIs. Obtain from the reviewer service.
REVIEWER_URI=https://reviewer-backend-staging-239934307367.asia-south2.run.app/api

# ─── GCP Cloud Storage ────────────────────────────────────────────────────────
# For uploading images/videos to Google Cloud Storage (Nearline class)
GCP_PROJECT_ID=your-gcp-project-id
GCP_BUCKET_NAME=your-bucket-name
GCP_KEY_FILE=  # path to service account JSON; omit to use Application Default Credentials

# ─── PineLabs (Payment Verification) ────────────────────────────────────────
# Set PINELABS_ENV=sandbox for UAT/test, 'production' for live
PINELABS_ENV=sandbox
PINELABS_MERCHANT_ID=your-merchant-id
PINELABS_CLIENT_ID=your-client-id
PINELABS_CLIENT_SECRET=your-client-secret
PINELABS_WEBHOOK_SECRET=  # Optional: for verifying incoming webhook signatures
PINELABS_MOCK_VERIFICATION=true  # Set to false in production

# ─── Razorpay (Standard Web Checkout) ────────────────────────────────────────
RAZORPAY_API_KEY=your-razorpay-api-key
RAZORPAY_SECRET=your-razorpay-secret
RAZORPAY_ENV=sandbox  # 'sandbox' for UAT/test, 'production' for live
RAZORPAY_ACCOUNT_NUMBER=your-razorpay-account-number
RAZORPAY_MOCK_VERIFICATION=true  # Set to false in production
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ─── Payment Encryption ───────────────────────────────────────────────────────
# 32-byte hex key for encrypting payment details at rest
PAYMENT_DETAILS_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# ─── Proxy for VM Server Traffic ─────────────────────────────────────────────
# Route VM server traffic (AI/GDB/Gemma/Embed at 100.100.108.44) through a
# SOCKS/HTTP proxy when running outside the tailnet.
# Set USE_VM_PROXY=false for local dev with a direct route.
USE_VM_PROXY=true
VM_PROXY_SOCKS_URL=socks5h://localhost:1055
VM_PROXY_HTTP_URL=http://localhost:1055

# ─── AI / LLM Services ────────────────────────────────────────────────────────
# Self-hosted models on your VM
VM_SERVER_URL=http://<your-vm-ip>
GEMMA_PORT=8014
GEMMA_API_KEY=your-gemma-api-key
GEMMA_VERSION=v1
GEMMA_MODEL=google/gemma-4-E4B-it

# GraphDB / document indexing
GDB_PORT=8110
GDB_API_KEY=your-gdb-api-key

# Embedding service
EMBED_PORT=6001