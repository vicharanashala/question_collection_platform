# Application
NODE_ENV=development
PORT=3000
OTP_RATE_LIMIT=false  # Disable in dev to avoid throttle noise during testing
THROTTLE_ENABLED=false # Set to false to disable NestJS global throttle in dev

# Database
DB=postgres                        # 'mongo' | 'postgres'
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=annam
DB_PASSWORD=<YOUR_DB_PASSWORD>
DB_NAME=question_platform

# MongoDB (used when DB=mongo)
MONGO_URI=mongodb://localhost:27017/question_platform
MONGO_USER=
MONGO_PASSWORD=

# JWT
JWT_SECRET=<YOUR_JWT_SECRET>
JWT_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>
REDIS_DB=1

# SMS Gateway
SMS_PROVIDER=mock
# SMS_PROVIDER=fast2sms

SMS_API_KEY=<YOUR_SMS_API_KEY>
SMS_API_SECRET=<YOUR_SMS_API_SECRET>
SMS_SENDER_ID=AGRIAPP

# Fast2SMS
FAST2SMS_SENDER_ID=Annam.Ai
FAST2SMS_API_KEY=<YOUR_FAST2SMS_API_KEY>
FAST2SMS_ROUTE=q

# Sarvam AI (Speech-to-Text & Translate)
SARVAM_API_KEY=<YOUR_SARVAM_API_KEY>
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_TRANSLATE_URL=https://api.sarvam.ai/translate

# LGD (To fetch districts, sub-districts, and states data)
LGD_API_KEY=<YOUR_LGD_API_KEY>
LGD_VILLAGES_API_URL=https://api.data.gov.in/resource/f17a1608-5f10-4610-bb50-a63c80d83974
LGD_STATES_API_URL=https://api.data.gov.in/resource/a71e60f0-a21d-43de-a6c5-fa5d21600cdb
LGD_DISTRICTS_API_URL=https://api.data.gov.in/resource/37231365-78ba-44d5-ac22-3deec40b9197
LGD_SUBDISTRICTS_API_URL=https://api.data.gov.in/resource/6be51a29-876a-403a-a6da-42fde795e751

# GCP Cloud Storage (Nearline class for images)
GCP_PROJECT_ID=<YOUR_GCP_PROJECT_ID>
GCP_BUCKET_NAME=<YOUR_GCP_BUCKET_NAME>
GCP_KEY_FILE=<PATH_TO_SERVICE_ACCOUNT_JSON>

# PineLabs (payment verification)
PINELABS_ENV=sandbox  # 'sandbox' for UAT/test, 'production' for live
PINELABS_MERCHANT_ID=<YOUR_PINELABS_MERCHANT_ID>
PINELABS_CLIENT_ID=<YOUR_PINELABS_CLIENT_ID>
PINELABS_CLIENT_SECRET=<YOUR_PINELABS_CLIENT_SECRET>
PINELABS_WEBHOOK_SECRET=<YOUR_PINELABS_WEBHOOK_SECRET>  # Optional: for verifying incoming webhook signatures
PINELABS_MOCK_VERIFICATION=true

# Razorpay Standard Web Checkout
RAZORPAY_API_KEY=<YOUR_RAZORPAY_API_KEY>
RAZORPAY_SECRET=<YOUR_RAZORPAY_SECRET>
RAZORPAY_ENV=sandbox
RAZORPAY_ACCOUNT_NUMBER=<YOUR_RAZORPAY_ACCOUNT_NUMBER>
RAZORPAY_MOCK_VERIFICATION=true
RAZORPAY_WEBHOOK_SECRET=<YOUR_RAZORPAY_WEBHOOK_SECRET>

PAYMENT_DETAILS_ENCRYPTION_KEY=<YOUR_PAYMENT_DETAILS_ENCRYPTION_KEY>

# ─── AI Services ───────────────────────────────────────────────────────────────
VM_SERVER_URL=http://<YOUR_VM_SERVER_IP>
GEMMA_PORT=8014
GEMMA_API_KEY=<YOUR_GEMMA_API_KEY>
GEMMA_VERSION=v1
GEMMA_MODEL=google/gemma-4-E4B-it
GDB_PORT=8110
GDB_API_KEY=<YOUR_GDB_API_KEY>
EMBED_PORT=6001