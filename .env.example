# ─── Docker Compose — Redis service ───────────────────────────────────────────
# These are read directly by docker-compose.yml (no env_file key needed).
# Place this file at the repo root and copy to .env for local development.

# Redis bind address — 127.0.0.1 = localhost only, 0.0.0.0 = accessible externally
REDIS_BIND=127.0.0.1

# Redis password — must match REDIS_PASSWORD in backend/.env if auth is enabled
REDIS_PASSWORD=redis_default_pass