# ─── Docker Compose — Redis service ───────────────────────────────────────────
# Read directly by docker-compose.yml at the repo root.
# Copy this file to .env for local development:  cp .env.example .env

# Redis bind address
#   127.0.0.1 = localhost only (default — safe for local dev)
#   0.0.0.0  = accessible externally (use with firewall rules / VPN in prod)
REDIS_BIND=127.0.0.1

# Redis password — must match REDIS_PASSWORD in backend/.env if auth is enabled
REDIS_PASSWORD=redis_default_pass