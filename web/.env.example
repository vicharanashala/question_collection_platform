# Backend API base path (used by Vite proxy in dev, full URL in production)
# In dev the Vite proxy forwards this to the backend; in production use the full Cloud Run URL
VITE_API_BASE_URL=/api/v1

# YouTube embed URL for the FAQ video section
# e.g. https://www.youtube.com/embed/VIDEO_ID
# Leave empty to hide the video section
VITE_PUBLIC_FAQ_VIDEO_URL=https://www.youtube.com/embed/dQw4w9WgXcQ

# Support email shown in locked account modal
VITE_SUPPORT_EMAIL=support@yourdomain.com